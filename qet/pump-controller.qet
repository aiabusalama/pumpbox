    <inputs>
      <input x="40" y="40" text="SUPPLIES &amp; DISTRIBUTION" font="Sans Serif,13,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="62" text="The single HLK-10M24 + LM2596 chain browned out a Pi 4. It is replaced by three separate isolated" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="76" text="Hi-Link supplies, all fed in parallel from the 143V DC bus, each feeding its own common rail." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="300" text="RAIL TAPS  (one load per bottom terminal)" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="322" text="+5V  b1 Pi Zero W   b2 LCD 20x4   b3 relay logic" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="336" text="+12V b1 K-WELL A1   b2 K-TANK A1" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="350" text="+24V b1 KM1 coil (through well interlock, folio 3)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="364" text="GND  common 0V return, jumper-linked" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="400" text="WHY THREE SUPPLIES" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="422" text="Isolated rails stop the Pi from browning out when" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="436" text="the 24V coil pulls in. Each load taps its own" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="450" text="terminal on a jumper-linked DIN rail - no wires" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="464" text="jammed together under one screw." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="500" text="POWER BUDGET" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="522" text="5V  rail  Pi 0.9W + LCD/logic 0.6W" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="536" text="12V rail  2x SSRC-04  ~0.6W" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="550" text="24V rail  KM1 coil    3.0W" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
    </inputs>
