      <input x="40" y="40" text="CONTROL &amp; LEVEL RELAYS" font="Sans Serif,13,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="62" text="Two SSRC-04 liquid-level relays (hacked to 12V DC). WELL is a hard safety interlock wired in series" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="76" text="with the coil; TANK drives Auto-mode fill through the Pi. Rails come from folio 2." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="150" y="300" text="well U/L/B" font="Sans Serif,8,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="410" y="300" text="tank U/L/B" font="Sans Serif,8,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="150" y="560" text="WELL CONTACT IN SERIES WITH COIL" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="150" y="580" text="K-WELL C/NO sits between +24V and the KM1 coil. Drop the" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="150" y="594" text="well level and NO opens - the coil de-energises no matter" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="150" y="608" text="what the Pi is doing. This is the hard dry-run interlock." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="150" text="PI TAPS (read-only, 5V logic)" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="172" text="K-WELL C/NO -&gt; Pi GPIO (well status, read)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="186" text="K-TANK C/NO -&gt; Pi GPIO (Auto-mode fill control)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="200" text="Both taps are level-shifted to the 5V rail." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="230" text="METER LINK" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="252" text="PZEM-017 A/B -&gt; MAX485 A/B" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="266" text="MAX485 RO -&gt; Pi pin 10  (GPIO15)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="280" text="MAX485 DI -&gt; Pi pin 8   (GPIO14)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="294" text="MAX485 DE+RE -&gt; Pi pin 12 (GPIO18)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="308" text="Modbus RTU  9600 8N2" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="400" text="FAIL-SAFE" font="Sans Serif,11,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="420" text="The contactor is normally open. Losing any PSU, the Pi," font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="434" text="a level relay or a dry well all drop the pump out. It" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="560" y="448" text="only runs while the well is wet AND the Pi holds it closed." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
    </inputs>
  </diagram>
</project>
