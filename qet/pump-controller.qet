    <inputs>
      <input x="40" y="40" text="SOLAR PUMP CONTROLLER - POWER PATH" font="Sans Serif,13,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="62" text="3 x GSE-HC455 in series. Voc 150.9V at 25C, ~165V cold." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="40" y="78" text="Pump card is destroyed above 150V, so the contactor stays open until the array settles." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="470" text="All three poles in series." font="Sans Serif,10,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="486" text="The LP1K0901BD is AC-rated; three gaps" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="500" text="in sequence break a 143V DC arc that" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="514" text="one gap cannot." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="610" text="Shunt goes in the NEGATIVE return," font="Sans Serif,10,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="626" text="between pump minus and array minus." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="640" text="Fat M6 bolts carry current; the two" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="654" text="small screws are the sense tap." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="250" text="Q1 is the only safe way to break" font="Sans Serif,10,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="266" text="this circuit. DC arcs do not self-" font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="280" text="extinguish - never pull a live joint." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="360" text="SPD must be DC-rated. An AC unit" font="Sans Serif,10,-1,5,75,0,0,0,0,0" rotation="0" tagg="none"/>
      <input x="400" y="376" text="looks identical and fails badly here." font="Sans Serif,9,-1,5,50,0,0,0,0,0" rotation="0" tagg="none"/>
    </inputs>
  </diagram>
